{
  "name": "software-maturity",
  "build": { "dockerfile": "Dockerfile", "context": "." },
  "remoteUser": "ubuntu",
  "mounts": [
    "source=software-maturity-claude,target=/home/ubuntu/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/ubuntu/.claude"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "prek install && scripts/conan_bootstrap.sh && conan config install-pkg .",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools",
        "xaver.clang-format",
        "editorconfig.editorconfig",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
